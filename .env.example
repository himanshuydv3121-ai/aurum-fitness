# Postgres connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Long random string, used to hash IP addresses for rate limiting.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Payment provider. Only "test" is built in (no real money moves).
PAYMENT_PROVIDER=test

# Used by `npm run seed` to create the first admin account. Password needs 10+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (booking confirmations, receipts, owner alerts). Without SMTP_URL, emails are only
# saved in the admin panel's outbox and not sent.
# Gmail: turn on 2-Step Verification, create an App Password, and write "@" as %40.
# SMTP_URL=smtps://himanshu.yadav370000%40gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:465
# MAIL_FROM=AURUM Fitness <himanshu.yadav370000@gmail.com>
# OWNER_EMAIL=himanshu.yadav370000@gmail.com
# Test it: node scripts/test-email.js himanshu.ydv310210@gmail.com
