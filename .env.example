# Postgres connection string (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Long random string, used to hash IP addresses for rate limiting.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Payment provider:
#   test      no money moves, the member confirms on the checkout page (for trying the site)
#   offline   member reserves a plan and pays at the front desk; the owner marks it paid in /admin
#   razorpay  real payments (UPI, cards, netbanking); needs the three RAZORPAY_ values below
PAYMENT_PROVIDER=test
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook URL to add in the Razorpay dashboard: https://YOUR-SITE/api/payments/webhook
# RAZORPAY_WEBHOOK_SECRET=

# Public address of the site, used for links in emails. Optional on Vercel.
# SITE_URL=https://your-site.example

# Used by `npm run seed` to create the first admin account. Password needs 10+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (booking confirmations, receipts, owner alerts). Without SMTP_URL, emails are only
# saved in the admin panel's outbox and not sent.
# Gmail: turn on 2-Step Verification, create an App Password, and write "@" as %40.
# SMTP_URL=smtps://himanshu.yadav370000%40gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:465
# MAIL_FROM=AURUM Fitness <himanshu.yadav370000@gmail.com>
# OWNER_EMAIL=himanshu.yadav370000@gmail.com
# Test it: node scripts/test-email.js himanshu.ydv310210@gmail.com
