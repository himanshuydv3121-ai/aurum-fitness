{
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10,
      "includeFiles": "templates/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-qOhFsq0QMV2REqNwk5hGH5bZE9SkX6gt6yeyKdYPv+U=' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.razorpay.com; connect-src 'self' https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://checkout.razorpay.com\")"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/programs",
      "destination": "/api/content?action=programs"
    },
    {
      "source": "/api/trainers",
      "destination": "/api/content?action=trainers"
    },
    {
      "source": "/api/plans",
      "destination": "/api/content?action=plans"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/api/payments/:action",
      "destination": "/api/payments?action=:action"
    },
    {
      "source": "/api/classes/:action",
      "destination": "/api/classes?action=:action"
    },
    {
      "source": "/api/newsletter/:action",
      "destination": "/api/newsletter?action=:action"
    },
    {
      "source": "/api/settings",
      "destination": "/api/content?action=settings"
    },
    {
      "source": "/media/:id",
      "destination": "/api/media?id=:id"
    },
    {
      "source": "/api/admin/:action",
      "destination": "/api/admin?action=:action"
    },
    {
      "source": "/",
      "destination": "/api/page?name=index"
    },
    {
      "source": "/about",
      "destination": "/api/page?name=about"
    },
    {
      "source": "/programs",
      "destination": "/api/page?name=programs"
    },
    {
      "source": "/trainers",
      "destination": "/api/page?name=trainers"
    },
    {
      "source": "/membership",
      "destination": "/api/page?name=membership"
    },
    {
      "source": "/contact",
      "destination": "/api/page?name=contact"
    },
    {
      "source": "/login",
      "destination": "/api/page?name=login"
    },
    {
      "source": "/account",
      "destination": "/api/page?name=account"
    },
    {
      "source": "/checkout",
      "destination": "/api/page?name=checkout"
    },
    {
      "source": "/admin",
      "destination": "/api/page?name=admin"
    },
    {
      "source": "/unsubscribe",
      "destination": "/api/page?name=unsubscribe"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/programs.html",
      "destination": "/programs",
      "permanent": true
    },
    {
      "source": "/trainers.html",
      "destination": "/trainers",
      "permanent": true
    },
    {
      "source": "/membership.html",
      "destination": "/membership",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/login.html",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/account.html",
      "destination": "/account",
      "permanent": true
    },
    {
      "source": "/checkout.html",
      "destination": "/checkout",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    }
  ],
  "cleanUrls": false
}
